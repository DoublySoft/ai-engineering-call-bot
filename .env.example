# ---- Ports (change if they clash with other projects; see docs/local-setup.md)
COMPOSE_PROJECT_NAME=voice-ai-lab
POSTGRES_HOST_PORT=55432
API_PORT=8000
WEB_PORT=3000

# ---- Postgres
POSTGRES_DB=voice_ai_lab
POSTGRES_USER=voice_ai
POSTGRES_PASSWORD=change-me
# Host-side URL (API running with uv on your machine -> published port).
# docker-compose overrides this for the `api` container (postgres:5432).
DATABASE_URL=postgresql+asyncpg://voice_ai:change-me@127.0.0.1:55432/voice_ai_lab

# ---- Lab security
# Required by every /api/* endpoint (sent by the Next.js server, never the browser).
ADMIN_API_TOKEN=generate-a-long-random-string
# Comma-separated E.164 numbers that outbound calls may dial.
OUTBOUND_ALLOWLIST=+34600000000
# Inbound callers allowed to reach the agent (empty = anyone who calls the lab's number).
INBOUND_ALLOWLIST=
MAX_CALL_DURATION_SECONDS=300
MAX_CALL_COST_USD=0.50
RECORD_AUDIO=false

# ---- Public URL that Twilio can reach (e.g. an ngrok/cloudflared tunnel to API_PORT)
PUBLIC_BASE_URL=https://your-tunnel.example.com

# ---- Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RETELL_API_KEY=

# ---- Default pipeline (overridable per call from the UI)
STT_PROVIDER=openai
STT_MODEL=gpt-transcribe
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Speech-to-speech engine (OpenAI Realtime)
S2S_MODEL=gpt-realtime-2.1-mini
# Retell (managed voice provider, browser sessions)
RETELL_VOICE_ID=cartesia-Isabel
# everything | everything_except_pii | basic_attributes_only (no transcripts/recordings kept at Retell)
RETELL_DATA_STORAGE=basic_attributes_only
AGENT_LANGUAGE=es

# ---- Observability: export OpenTelemetry spans (e.g. to a local Jaeger/Tempo/Collector). Empty = off.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=voice-ai-lab-api

# ---- Web (server-side only)
# Basic-auth password for the dashboard (any username). Required in production;
# without it `pnpm dev:web` only listens on 127.0.0.1.
LAB_WEB_PASSWORD=
API_INTERNAL_URL=http://127.0.0.1:8000
# Browser-side WebSocket base for live events
NEXT_PUBLIC_API_WS_URL=ws://127.0.0.1:8000
